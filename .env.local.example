# Copy this file to `.env.local` and fill in real values.
# All values here are placeholders.

# Supabase project (https://supabase.com) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Super admin (also see admin-credentials.txt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your-bcrypt-hash-from-seed.sql

# Used to sign the HTTP-only session cookie (32+ random bytes; `openssl rand -hex 32`)
SESSION_SECRET=your-random-secret

# Display name shown in the header / PDF reports
SCHOOL_NAME=Cantonment Public School and College, Rangpur
